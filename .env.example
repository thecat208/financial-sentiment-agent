# ===== LLM 配置 =====
# LLM提供者： anthropic / openai
LLM_PROVIDER=
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# 结构化输出方式：auto（默认，先试json_schema、服务端不支持时自动降级json_mode）
# 也可显式指定 json_schema / json_mode / function_calling
LLM_STRUCTURED_METHOD=auto

# ===== Embedding 配置 =====
# 可选 local（本地模型，免费但需要算力）/ openai（云端API，付费但省心）
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=

# ===== SQLite 配置 =====
SQLITE_DB_PATH=./data/sentiment.db

# ===== 日报配置 =====
REPORTS_DIR=./reports
# 每天几点自动生成日报（24小时制）
REPORT_HOUR=18
REPORT_MINUTE=0

# ===== 向量库配置 =====
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=financial_sentiment

# ===== 检索参数 =====
RETRIEVE_TOP_K=5
# 检索结果少于该数量时触发放宽条件重试
RETRIEVE_MIN_DOCS=2
# 最多放宽重试次数
RETRIEVE_MAX_RETRY=2

# ===== 企业级多租户 =====
DEFAULT_TENANT_ID=default

# ===== 多模态（图片OCR / 视频处理）=====
# tesseract语言包，需要系统装了对应包（apt-get install tesseract-ocr-chi-sim tesseract-ocr-eng）
OCR_LANG=chi_sim+eng
# 视频关键帧抽取间隔（秒），需要系统装了ffmpeg
VIDEO_FRAME_INTERVAL=30
# ASR语音转写方案：local=本地faster-whisper（默认，pip install faster-whisper）；
# cloud=云端ASR API（预留接入点，接入指引见 ingestion/multimodal/video_processor.py 的 _transcribe_audio docstring）
ASR_PROVIDER=local
# 本地whisper模型规模：tiny/base/small/medium/large-v3（small在纯CPU上速度/准确率较均衡）
# 首次运行自动从HuggingFace下载权重（small约460MB），国内网络慢可加一行：HF_ENDPOINT=https://hf-mirror.com
ASR_WHISPER_MODEL_SIZE=small
# 运行设备：auto=有CUDA走GPU否则CPU；也可强制cpu
ASR_WHISPER_DEVICE=auto
# 转写语言：zh=中文；auto=自动检测
ASR_LANGUAGE=zh

# ===== 对话记忆（多轮追问，工程化2.2）=====
# 每次问答拼进Prompt的最近对话轮数（短期滑动窗口）
MEMORY_CONTEXT_RECENT_TURNS=4
# 累计对话达到该轮数时，触发LLM把历史压缩为长期摘要
MEMORY_SUMMARY_TRIGGER_TURNS=16
# 压缩完成后短期窗口保留的最近轮数
MEMORY_TRIM_KEEP_TURNS=2

# ===== 缓存与Redis（工程化2.2 Redis会话与缓存）=====
# 不装redis/不启动Redis服务时，系统自动降级为进程内缓存与会话存储，不影响功能
REDIS_URL=redis://localhost:6379/0
# 检索结果缓存时长（秒），默认10分钟
CACHE_TTL_RETRIEVE=600
# LLM调用结果缓存时长（秒），默认1小时
CACHE_TTL_LLM=3600
# 热会话记忆TTL（秒），默认30分钟，每次访问滑动续期
SESSION_TTL_HOT=1800

# ===== Token与成本控制（工程化2.3）=====
# 模型上下文窗口；0=按模型名自动判断（Claude=200K，GPT-4o-mini=128K）
MODEL_CONTEXT_LIMIT=0
# 输入预算占上下文极限的比例，默认80%，预留系统提示词和输出空间
TOKEN_BUDGET_RATIO=0.8
# 系统提示词的token预留
TOKEN_SYSTEM_RESERVED=800
# 可用预算中分给对话历史的比例，其余给RAG检索文档
TOKEN_CONV_SHARE=0.3

# ===== LLM调用超时与重试（工程化2.4）=====
# 单次LLM调用超时（秒）
LLM_TIMEOUT=60
# 调用失败时指数退避重试的最大次数
LLM_MAX_RETRIES=3
# 退避基础间隔（秒），实际间隔 = base * 2^attempt + 随机抖动
RETRY_BASE_DELAY=1.0

# ===== 异步任务队列与限流（工程化2.5）=====
# 后台worker并发数（任务队列消费线程数）
TASK_QUEUE_CONCURRENCY=2
# Redis队列key（使用Redis后端时）
TASK_QUEUE_NAME=tasks:queue
# 全局令牌桶：每秒补充令牌数（整体QPS上限）
RATE_LIMIT_GLOBAL_QPS=20
# 令牌桶容量（允许瞬时突发）
RATE_LIMIT_GLOBAL_BURST=40
# 单用户限流窗口（秒）
RATE_LIMIT_USER_WINDOW_SEC=2
# 单用户在窗口内的最大请求数
RATE_LIMIT_USER_MAX=1

# ===== 知识图谱=====
# auto=优先Neo4j、连不上自动降级NetworkX；neo4j=强制Neo4j；networkx=强制NetworkX
KG_PROVIDER=auto
# Neo4j连接信息（docker run -d -p 7687:7687 -p 7474:7474 neo4j:5，默认账号neo4j/neo4j）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# NetworkX降级后端时的图持久化文件
KG_FILE_PATH=./data/knowledge_graph.json
# 构建图时是否加载内置种子金融知识库
KG_LOAD_SEED=true

# ===== 向量索引重建=====
# 每日重建时间（小时，凌晨）
VECTOR_REBUILD_HOUR=2
# 活跃Chroma集合指针文件（重建后切换集合名）
CHROMA_ACTIVE_POINTER=./data/chroma_active.json

# ===== 安全与合规=====
# 敏感词清单文件路径（每行一个词）；留空用内置默认清单
SENSITIVE_WORDS_FILE=
# 是否启用敏感词过滤（输入拦截 + 入库正文打码）
ENABLE_SENSITIVE_FILTER=true
# 是否在问答/日报末尾强制拼接免责声明
ENABLE_DISCLAIMER=true

# ===== 预警推送配置 =====
# Server酱（https://sct.ftqq.com/）微信推送，免费额度个人够用
SERVERCHAN_KEY=your_serverchan_key

# ===== 舆情-行情关联分析与回测）=====
# akshare=优先真实A股行情，未安装/取不到数据/非A股代码时自动降级为mock演示数据
# mock=强制使用演示数据
MARKET_DATA_PROVIDER=akshare
# 行情数据缓存时长（秒），默认4小时
MARKET_DATA_CACHE_TTL=14400
# 回测默认持有交易日数
BACKTEST_DEFAULT_HOLDING_DAYS=5
# 样本量低于此值时提示"样本过少，仅供参考"
BACKTEST_MIN_SAMPLES=5

# ===== 专业数据源与公告全文接入=====
# 公告采集默认回溯天数
ANNOUNCEMENT_LOOKBACK_DAYS=7
# 是否尝试下载公告PDF并抽取全文（需要pip install pdfplumber，未安装时自动降级为仅用标题）
ANNOUNCEMENT_FETCH_FULLTEXT=true
# 公告PDF全文超过此字数截断
ANNOUNCEMENT_FULLTEXT_MAX_CHARS=3000

# ===== FastAPI 对外接口 =====
API_HOST=0.0.0.0
API_PORT=8000
# 留空=不校验（本地开发/演示默认）；生产环境务必设置，否则接口对公网完全开放
API_KEY=
# 允许跨域访问的来源，逗号分隔；"*"=允许所有来源（仅本地开发用）
API_CORS_ORIGINS=*

# ===== 轻量模型前置筛选=====
# 是否启用前置筛选；关闭则每条都直接走LLM（等价于升级前的行为，用于AB对比基线）
ENABLE_LIGHTWEIGHT_PREFILTER=true
# auto=优先transformer小模型、不可用自动降级lexicon词典规则；transformer=强制小模型；lexicon=强制词典规则
LIGHTWEIGHT_SENTIMENT_BACKEND=auto
# transformer后端使用的HuggingFace模型（需要能联网下载权重，仅首次运行需要）
LIGHTWEIGHT_HF_MODEL=uer/roberta-base-finetuned-jd-binary-chinese
# HuggingFace权重下载慢时的国内镜像（对transformer后端模型和whisper模型都生效）
# HF_ENDPOINT=https://hf-mirror.com
# 置信度阈值：达到才采纳轻量模型结果直接跳过LLM，没达到则升级LLM完整分析
LIGHTWEIGHT_CONFIDENCE_THRESHOLD=0.6

# ===== 多渠道推送与导出（产品化 P13）=====
# 启用哪些预警/日报推送渠道，逗号分隔；可选 wechat/dingtalk/feishu/wecom/slack/email
ALERT_PUSH_CHANNELS=wechat

# 钉钉自定义机器人（安全设置选"加签"时才需要填SECRET，选"自定义关键词"等方式可以留空）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 飞书自定义机器人
FEISHU_WEBHOOK=
FEISHU_SECRET=

# 企业微信群机器人（Webhook地址里已经带了key）
WECOM_WEBHOOK=

# Slack Incoming Webhook
SLACK_WEBHOOK=

# 邮件推送（SMTP）
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_USE_SSL=true

# 日报导出（Excel/PDF）文件输出目录
EXPORT_DIR=./exports
